{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LConnect Lite",
  "version": "0.3.0",
  "identifier": "com.creeperux.lconnect-lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LConnect Lite",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "OliverArcher",
    "copyright": "MIT License · 与联力（Lian Li）官方无关",
    "shortDescription": "LConnect Lite",
    "longDescription": "TL无线风扇组独立调速与灯效、8.8灯环控制，保留水冷支持；屏幕内容由外部宿主管理。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/lcl-daemon",
      "binaries/lcl-sensord",
      "binaries/lcl-display-host"
    ],
    "licenseFile": "installer/notice.txt",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../vendor/pawnio/PawnIO_setup.exe": "pawnio/PawnIO_setup.exe",
      "../../vendor/pawnio/COPYING-modules.txt": "pawnio/COPYING-modules.txt"
    }
  },
  "mainBinaryName": "lcl-app"
}
